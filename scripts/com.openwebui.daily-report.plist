<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent: runs scripts/daily_report.sh every day at 09:00.

  Install:
    cp scripts/com.openwebui.daily-report.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.openwebui.daily-report.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.openwebui.daily-report.plist
    rm ~/Library/LaunchAgents/com.openwebui.daily-report.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openwebui.daily-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/istale/Documents/open-webui-based-project/scripts/daily_report.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/owui-daily-report.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/owui-daily-report.err</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
